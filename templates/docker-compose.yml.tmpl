services:
  app:
    build:
      context: ./app
      dockerfile: Dockerfile
    container_name: {{ .appContainerName }}
    restart: unless-stopped
    expose:
      - "{{ .appPort }}"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:{{ .appPort }}/health"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s

  proxy:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ .proxyContainerName }}
    restart: unless-stopped
    depends_on:
      app:
        condition: service_healthy
    ports:
      - "{{ .proxyPort }}:{{ .proxyPort }}"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:{{ .proxyPort }}/nginx-health"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s